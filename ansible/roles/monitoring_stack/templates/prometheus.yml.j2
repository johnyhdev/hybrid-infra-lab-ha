global:
  scrape_interval: "{{ monitoring_prometheus_scrape_interval }}"
  scrape_timeout: "{{ monitoring_prometheus_scrape_timeout }}"
  evaluation_interval: "{{ monitoring_prometheus_evaluation_interval }}"
  external_labels:
    replica: "{{ inventory_hostname }}"

rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  # Both CM Prometheus replicas evaluate the same pushed series. Drop only the
  # per-replica external label before Alertmanager so the HA pair deduplicates
  # equivalent alerts and the recovery dispatcher does not act twice.
  alert_relabel_configs:
    - action: labeldrop
      regex: replica
  alertmanagers:
    - static_configs:
        - targets:
{% for peer in groups['control'] %}
            - "{{ hostvars[peer].ansible_host }}:{{ monitoring_alertmanager_port }}"
{% endfor %}

scrape_configs:
  - job_name: prometheus
    scheme: https
    tls_config:
      server_name: "{{ tailscale_dns_name }}"
      ca_file: /etc/ssl/certs/ca-certificates.crt
      insecure_skip_verify: false
    static_configs:
      - targets: ["127.0.0.1:{{ monitoring_prometheus_port }}"]
        labels:
          instance: "{{ inventory_hostname }}"

