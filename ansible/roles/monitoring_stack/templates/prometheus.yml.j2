global:
  scrape_interval: "{{ monitoring_prometheus_scrape_interval }}"
  scrape_timeout: "{{ monitoring_prometheus_scrape_timeout }}"
  evaluation_interval: "{{ monitoring_prometheus_evaluation_interval }}"
  external_labels:
    replica: "{{ inventory_hostname }}"

rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets:
{% for peer in groups['control'] %}
            - "{{ hostvars[peer].ansible_host }}:{{ monitoring_alertmanager_port }}"
{% endfor %}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["{{ ansible_host }}:{{ monitoring_prometheus_port }}"]
        labels:
          instance: "{{ inventory_hostname }}"

{% for host in groups['control'] + groups['workload'] %}
  - job_name: node_exporter_{{ host | replace('-', '_') }}
    scheme: https
    tls_config:
      server_name: "{{ hostvars[host].tailscale_dns_name }}"
      ca_file: /etc/ssl/certs/ca-certificates.crt
      insecure_skip_verify: false
    static_configs:
      - targets: ["{{ hostvars[host].azure_private_ip }}:{{ monitoring_node_exporter_port }}"]
        labels:
          instance: "{{ host }}"
    relabel_configs:
      - target_label: job
        replacement: node_exporter
{% endfor %}

