apiVersion: 1

datasources:
  - name: Prometheus
    uid: phase8-prometheus
    type: prometheus
    access: proxy
    url: "https://127.0.0.1:{{ monitoring_prometheus_port }}"
    jsonData:
      tlsSkipVerify: false
      serverName: "{{ tailscale_dns_name }}"
    isDefault: true
    editable: false

  - name: Loki
    uid: phase8-loki
    type: loki
    access: proxy
    url: "http://127.0.0.1:{{ monitoring_loki_proxy_port }}"
    editable: false
