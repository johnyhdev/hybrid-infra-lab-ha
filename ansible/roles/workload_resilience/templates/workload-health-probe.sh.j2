#!/usr/bin/env bash
set -euo pipefail

metric_dir=/var/lib/alloy/textfile
output="$metric_dir/phase8_workload.prom"
tmp="$(mktemp "$metric_dir/.phase8_workload.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

cloudflared_expected=0
{% if inventory_hostname in groups['cloudflare_ingress'] %}
cloudflared_expected=1
{% endif %}
cloudflared=0
if [[ "$cloudflared_expected" == 1 ]] && systemctl is-active --quiet cloudflared.service && curl -fsS --max-time 2 http://127.0.0.1:{{ cloudflared_metrics_port }}/metrics >/dev/null; then
  cloudflared=1
fi
printf 'phase8_cloudflared_expected %s\n' "$cloudflared_expected" >> "$tmp"
printf 'phase8_cloudflared_active %s\n' "$cloudflared" >> "$tmp"

proxy=0
if curl -fsS --max-time 3 http://127.0.0.1:{{ workload_proxy_port }}/livez >/dev/null; then
  proxy=1
fi
printf 'phase8_nginx_proxy_active %s\n' "$proxy" >> "$tmp"

pool_ready=0
if curl -fsS --max-time 5 http://127.0.0.1:{{ workload_proxy_port }}/readyz >/dev/null; then
  pool_ready=1
fi
printf 'phase8_workload_pool_ready %s\n' "$pool_ready" >> "$tmp"

backend=0
probe="$(curl --fail --silent --show-error --max-time 3 \
  --resolve '{{ tailscale_dns_name }}:{{ workload_web_port }}:{{ workload_private_ip }}' \
  -w '%{http_code} %{time_total}' \
  "https://{{ tailscale_dns_name }}:{{ workload_web_port }}/healthz" 2>/dev/null || true)"
status="${probe%% *}"
duration="${probe##* }"
if [[ "$status" == "200" ]]; then backend=1; fi
printf 'phase8_backend_healthy{backend="{{ inventory_hostname }}"} %s\n' "$backend" >> "$tmp"
if [[ "$duration" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
  printf 'phase8_http_probe_duration_seconds{backend="{{ inventory_hostname }}"} %s\n' "$duration" >> "$tmp"
fi
printf 'phase8_http_probe_status{backend="{{ inventory_hostname }}"} %s\n' "${status:-0}" >> "$tmp"

{% if hostvars[inventory_hostname].is_database | default(false) %}
database_ready=0
if pg_isready -q; then database_ready=1; fi
printf 'phase8_postgresql_ready %s\n' "$database_ready" >> "$tmp"
{% endif %}

chown root:alloy "$tmp"
chmod 0640 "$tmp"
mv "$tmp" "$output"
trap - EXIT
