{% set workload_pool = (cloudflare_tunnel_pools | selectattr('members', 'contains', inventory_hostname) | list | first) %}
{% set workload_backend_hosts = (cloudflare_tunnel_pools | selectattr('service_group', 'equalto', workload_pool.service_group) | map(attribute='members') | flatten | unique | list) %}
upstream workload_apps {
    least_conn;
{% for host in workload_backend_hosts %}
    server {{ hostvars[host].workload_private_ip }}:{{ workload_web_port }} max_fails=2 fail_timeout=5s;
{% endfor %}
    keepalive 32;
}

map $upstream_addr $backend_tls_name {
    default "";
{% for host in workload_backend_hosts %}
    ~*{{ hostvars[host].workload_private_ip | regex_escape }}:{{ workload_web_port }} "{{ hostvars[host].tailscale_dns_name }}";
{% endfor %}
}

# Local web/application endpoint; peer proxies use this port as an upstream.
server {
    listen {{ workload_web_port }} ssl default_server;
    server_name _;
    ssl_certificate /etc/phase8/tls/tls.crt;
    ssl_certificate_key /etc/phase8/tls/tls.key;

    location = /healthz {
        proxy_pass http://127.0.0.1:{{ sample_app_port }}/;
        proxy_connect_timeout 2s;
        proxy_read_timeout 3s;
    }

    location / {
        proxy_pass http://127.0.0.1:{{ sample_app_port }};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Cloudflare Tunnel targets this local listener. This server fans out to
# dynamically discovered private workload backends, including this VM.
server {
    listen {{ workload_proxy_port }};
    server_name _;

    location = /healthz {
        proxy_pass https://127.0.0.1:{{ workload_web_port }}/healthz;
        proxy_ssl_server_name on;
        proxy_ssl_name {{ tailscale_dns_name }};
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_verify_depth 4;
        proxy_connect_timeout 2s;
        proxy_read_timeout 3s;
    }

    location / {
        proxy_pass https://workload_apps;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
        proxy_ssl_name $backend_tls_name;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_verify_depth 4;
        proxy_connect_timeout {{ workload_proxy_connect_timeout }};
        proxy_read_timeout {{ workload_proxy_read_timeout }};
        proxy_send_timeout {{ workload_proxy_send_timeout }};
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries {{ workload_proxy_max_tries }};
    }
}
